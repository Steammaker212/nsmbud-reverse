*.elf
*.nso
*.nsp
*.xci
*.pack
*.szs
*.i64
*.id0
*.id1
*.id2
*.idb
*.nam
*.til
*.til.bak
*.exe
*.dll
*.so

# ---- Reference trees (live on the wiiu-reference branch) ----
refs/
red-pro2/
NSMBU-Headers/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Extracted archive scratch (scripts/sarc.py output) ----
.rea/*.bfres
.rea/*.bfsha

# ---- Local scratch ----
*.tmp
*.bak
*.log.tmp
scratch/
out/

# ---- Third-party GPL-3.0 reference (never vendor; see docs/CODEDX_REFERENCE.md) ----
codedx/

# ---- Loader build products ----
# The loader's `out/` is already covered above; these catch the rest.
loader/build/
loader/out/
loader/main.ld
loader/objdump*.txt

# ---- The sweet-dx test harness ----
# sweetdx-test/ is a *copy* of sweet-dx's tree used to compile our hooks through
# a harness known to work on hardware. The 95 MB executable and the whole copied
# include tree are third-party GPL-3.0 material, so only our own additions
# (source/code/hooks.cpp, source/code/runtime_proof.cpp, the generated .hks and
# .sym) are worth tracking -- and those are reproducible from
# scripts/pipeline/emit_sweetdx_project.py.
sweetdx-test/sweet-dx.exe
sweetdx-test/source/include/
sweetdx-test/source/nso/
sweetdx-test/source/symbols/main.sym
sweetdx-test/proof_out/
sweetdx-test/proof_build.log
sweetdx-test/*.log


# ---- SweetDX input: the retail NSO, supplied by the user, never committed ----
# sweetdx/nso/README.md is tracked; the 8 MB image next to it is not.
sweetdx/nso/main

# ---- SweetDX build output: NEVER commit these ----
# Build artefacts are reproducible from sweetdx/hooks + sweetdx/code + sweetdx/symbols.
# Committing them bloats the repo, and a stale build is worse than no build because it
# looks authoritative. Test builds are shared out-of-band, not through git history.
# The patterns cover output/, output_stepN_*/, and the atmosphÃ¨re tree they contain.
sweetdx/output*/
sweetdx/out*/
atmosphere/

# ---- SweetDX build logs: local diagnostics, not deliverables ----
sweetdx/build_test.log

# ---- Mod builds (scripts/sdk/make_mod_project.py) ----
# Each build/ holds an assembled sweet-dx tree: a copy of the game's NSO at
# source/nso/main (no extension, so *.nso does not catch it), the GPL-3.0
# codedx template code, and the built subsdk0/IPS. None of it is ours to ship.
mods/*/build*/
mods/build*/
mods/*/sd_backup_*/
**/nso/main

# generated mod build trees (regenerated by make_mod_project.py --build)
mods/*_build/
mods/**/_build/

# extracted archive dumps (regenerated by the SARC parser)
.rea/choropoo/
