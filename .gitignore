# Project
.projectignore/

# ---- Game binaries & IDA artifacts (never distribute) ----
*.elf
*.nso
*.nsp
*.xci
*.pack
*.szs
*.i64
*.id0
*.id1
*.id2
*.idb
*.nam
*.til
*.til.bak
*.exe
*.dll
*.so

# ---- Reference trees (live on the wiiu-reference branch) ----
refs/
red-pro2/
NSMBU-Headers/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Local scratch ----
*.tmp
*.bak
*.log.tmp
scratch/
out/

# ---- Mod builds (scripts/sdk/make_mod_project.py) ----
# Each build/ holds an assembled sweet-dx tree: a copy of the game's NSO at
# source/nso/main (no extension, so *.nso does not catch it), the GPL-3.0
# codedx template code, and the built subsdk0/IPS. None of it is ours to ship.
source/nso/
source/nso/main
yaz0moto/patches/steam-dx/icons/

# tools/wiiu2dx build output
tools/wiiu2dx/bin/
tools/wiiu2dx/obj/