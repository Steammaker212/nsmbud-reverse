<Project Sdk="Microsoft.NET.Sdk">
  <!--
    suittex: adds a texture and a frame to a player model's switch animations. See its README.
    Uses the libraries tools/wiiu2dx built: run `dotnet build -c Release tools/wiiu2dx` first.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Libs>$(MSBuildThisFileDirectory)..\wiiu2dx\bin\Release\net9.0\</Libs>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BfresLibrary"><HintPath>$(Libs)BfresLibrary.dll</HintPath></Reference>
    <Reference Include="Syroot.BinaryData"><HintPath>$(Libs)Syroot.BinaryData.dll</HintPath></Reference>
    <Reference Include="Syroot.Maths"><HintPath>$(Libs)Syroot.Maths.dll</HintPath></Reference>
    <Reference Include="Syroot.NintenTools.NSW.Bntx"><HintPath>$(Libs)Syroot.NintenTools.NSW.Bntx.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(Libs)Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
