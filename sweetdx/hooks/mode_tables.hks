@Power-up mode lookup tables (height, body type, draw offset).
@
@ Generated from the verified byte diff between the stock NSMBU Deluxe v1.0.0
@ main NSO and the Hammer power-up build. Every hook below corresponds to a
@ word that actually differs; the full diff is 115 bytes across 59 regions with
@ nothing unaccounted for.
@
@ SweetDX format: an unindented 'name:' header, indented 'key: value' fields,
@ and '@' comments. 'instr' hooks are reassembled by clang and were round-trip
@ verified against the patched bytes; 'data' hooks are written verbatim.

body_table_redirect_a:
    @ Redirect to the relocated body-type table.
    type:    instr
    instruction: mlaseq fp, r8, lr, ip
    address: 0x0078C58C

body_table_redirect_b:
    @ Redirect to the relocated body-type table (second reader).
    type:    instr
    instruction: eorseq sl, fp, r8, lsl lr
    address: 0x0078E604

mode_six_or_ten:
    @ A gate that special-cases mode 6 now also special-cases mode 10.
    type:    instr
    instruction: cmp r0, #0xa
    address: 0x0078E6A8

body_table_redirect_c:
    @ Redirect to the relocated body-type table (third reader).
    type:    instr
    instruction: eorseq sl, fp, r8, lsr #27
    address: 0x0078E7E8

height_table_redirect_a:
    @ Redirect to the relocated height table.
    type:    instr
    instruction: eorseq r3, fp, r4, ror #12
    address: 0x00795FF0

height_table_redirect_b:
    @ Redirect to the relocated height table (second reader).
    type:    instr
    instruction: mlaseq fp, r0, r3, r3
    address: 0x007960F8

draw_offset_redirect:
    @ Redirect to the relocated draw-offset table.
    type:    instr
    instruction: eorseq r1, fp, r0, ror #3
    address: 0x007982D8

tall_actor_type_hammer:
    @ Tall-actor table: mode 10 uses body type 2.
    type:    data
    data:    02 00 00 00
    address: 0x00B0C328

height_table_slot_10:
    @ Relocated height table: mode 10 height.
    type:    data
    data:    00 00 80 41
    address: 0x00B493A8

