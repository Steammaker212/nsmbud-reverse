@Power-up mode 10 through the item-grant gate (? blocks, item pickups).
@
@ Generated from the byte diff between the stock NSMBU Deluxe v1.0.0 main NSO and the
@ Hammer reference build. NOTE: "came from the diff" is not a correctness claim. Six
@ hooks in mode_tables.hks also came from the diff, reproduced it byte-perfectly, and
@ still broke the game. See docs/INCIDENT_2026-10-22.md.
@
@ SweetDX format: an unindented 'name:' header, indented 'key: value' fields, and '@'
@ comments. 'instr' hooks are reassembled by clang and were round-trip verified against
@ the reference bytes; 'data' hooks are written verbatim.

item_gate_max_mode:
    @ Item gate: widen the accepted mode range to 9 (index 9 = mode 10).
    type:    instr
    instruction: cmp r0, #9
    address: 0x00465F34

item_gate_mode_mask:
    @ Item gate: mask 0x3FB so bit 9 (mode 10) is accepted.
    type:    instr
    instruction: movw r1, #0x3fb
    address: 0x00465F40

item_gate_max_mode_2:
    @ Item gate (second call site): widen the accepted mode range.
    type:    instr
    instruction: cmp r0, #9
    address: 0x00466000

item_gate_mode_mask_2:
    @ Item gate (second call site): mask 0x3FB.
    type:    instr
    instruction: movw r1, #0x3fb
    address: 0x0046600C
