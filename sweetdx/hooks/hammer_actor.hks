@Hammer power-up: actor construction and projectile body setup.
@
@ Generated from the verified byte diff between the stock NSMBU Deluxe v1.0.0
@ main NSO and the Hammer power-up build. Every hook below corresponds to a
@ word that actually differs; the full diff is 115 bytes across 59 regions with
@ nothing unaccounted for.
@
@ SweetDX format: an unindented 'name:' header, indented 'key: value' fields,
@ and '@' comments. 'instr' hooks are reassembled by clang and were round-trip
@ verified against the patched bytes; 'data' hooks are written verbatim.

hammer_direction_bit:
    @ Direction comes from a single packed bit, not a two-bit field.
    type:    instr
    instruction: ubfx r1, r0, #4, #1
    address: 0x0013FB38

hammer_scale_denom:
    @ Scale divisor 10 (was 8): Hammer bodies render at the right size.
    type:    instr
    instruction: mov r0, #0xa
    address: 0x0013FB68

hammer_ctor_read_settings:
    @ Constructor: read settings1 from +0x14.
    type:    instr
    instruction: ldr r6, [r4, #0x14]
    address: 0x00140744

hammer_ctor_mask:
    @ Constructor: mask the settings field.
    type:    instr
    instruction: and r6, r6, #0xf
    address: 0x00140748

hammer_ctor_or_mode:
    @ Constructor: pack the power-up mode into the settings word.
    type:    instr
    instruction: orr r6, r6, #0x13000000
    address: 0x0014074C

hammer_ctor_or_player:
    @ Constructor: pack the player byte.
    type:    instr
    instruction: orr r6, r6, #0xff00
    address: 0x00140770

hammer_ctor_store:
    @ Constructor: store the packed word into playerId/layer/type.
    type:    instr
    instruction: str r6, [r4, #0x54]
    address: 0x00140778
