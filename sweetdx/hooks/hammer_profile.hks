@Hammer power-up: register the Hammer actor as a power-up mode.
@
@ Generated from the verified byte diff between the stock NSMBU Deluxe v1.0.0
@ main NSO and the Hammer power-up build. Every hook below corresponds to a
@ word that actually differs; the full diff is 115 bytes across 59 regions with
@ nothing unaccounted for.
@
@ SweetDX format: an unindented 'name:' header, indented 'key: value' fields,
@ and '@' comments. 'instr' hooks are reassembled by clang and were round-trip
@ verified against the patched bytes; 'data' hooks are written verbatim.

grant_hammer_mode:
    @ Granting the Hammer gives power-up mode 10.
    type:    instr
    instruction: mov r2, #0xa
    address: 0x0045DDCC

hammer_actor_info_flags:
    @ Second ActorInfo record: clear the fire-specific flag word.
    type:    data
    data:    00 00 00 00
    address: 0x00AF6620

hammer_actor_info_subtype:
    @ ActorInfo subtype -> 19 so the Hammer body is treated like a thrown projectile.
    type:    data
    data:    13 00 00 00
    address: 0x00BD3208

hammer_actor_info_dist:
    @ ActorInfo hit distances: zero out the fire-specific vertical offset.
    type:    data
    data:    01 00 08 00
    address: 0x00BD3210

hammer_profile_cell:
    @ Point the power-up slot at the Hammer profile (759) instead of the Fire Flower (476).
    type:    data
    data:    04 39 AF 00
    address: 0x00C61BE4
