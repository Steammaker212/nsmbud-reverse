@ Slide Suit: a Penguin Suit that always slides, bounces off walls, and spins.
@ Deluxe (Switch) v1.0.0 only.
@
@ BrosBase::onExecute (0x60263D10, RVA 0x00263D10). Chosen because the player
@ runs it every frame in every state -- it is the function that calls
@ StateMgr::execute itself -- so one hook covers Move, Jump, Attack and the rest.
@ sdk/data/hookable.csv: 308 bytes, entry "push {r4, r5, r6, lr}" (0xe92d4070),
@ trampoline_safe = yes.

SlideSuit_onExecute:
    type:       hook
    address:    0x00263D10
    symbol:     SlideSuit_onExecute
    trampoline: SlideSuit_onExecute_orig

@ ActiveCollider_doOverlapMaybe (0x601597E8, RVA 0x001597E8) -- the collider-pair
@ test. It invokes the callbacks of BOTH colliders, so hooking it is how a
@ player-side mod learns which block it is touching. The block's bump handler is
@ BlockBase vtable+0x0A8 (vf16C 0x605640BC), verified exactly before dispatch.
@ sdk/data/hookable.csv: 576 bytes, entry "push {r4, r5, r6, r7, r8, r9, r10,
@ r11, lr}" (0xe92d4ff0), trampoline_safe = yes.

SlideSuit_doOverlap:
    type:       hook
    address:    0x001597E8
    symbol:     SlideSuit_doOverlap
    trampoline: SlideSuit_doOverlap_orig
