# Memory allocation
#
# Addresses are RVAs (VA - 0x60000000). New Super Mario Bros. U Deluxe (Switch) v1.0.0 only.
# Each group's tag says where its names are declared: [codedx] in the codedx headers
# under include/, otherwise the header(s) holding the generated declarations. Names
# tagged [framework/mods] on an entry are the ones a framework part or mod needs.
# Constructors and destructors carry their C1/C2/D0/D1/D2 variant.

# aligned  [symbols only, no declaration]
aligned_alloc = 0x0083524C;

# calloc  [symbols only, no declaration]
calloc = 0x00835178;

# new/delete/malloc/free  [codedx]
operator new(unsigned int) = 0x008DE044;
operator new[](unsigned int) = 0x008DE09C;
operator delete(void*) = 0x008DE3A0;
operator delete[](void*) = 0x008DE3FC;
malloc = 0x00835108;
free = 0x0083515C;

# operator  [symbols only, no declaration]
operator_new_8DE0F4 = 0x008DE0F4;
operator_new_8DE14C = 0x008DE14C;
operator_new_8DE25C = 0x008DE25C;
operator_new_8DE2C8 = 0x008DE2C8;
operator_delete_8DE458 = 0x008DE458;
operator_delete_8DE4B4 = 0x008DE4B4;

# realloc  [symbols only, no declaration]
realloc = 0x008351F4;
