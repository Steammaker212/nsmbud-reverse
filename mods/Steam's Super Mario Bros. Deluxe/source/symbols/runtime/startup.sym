# Startup, static initialisers and root tasks
#
# Addresses are RVAs (VA - 0x60000000). New Super Mario Bros. U Deluxe (Switch) v1.0.0 only.
# Each group's tag says where its names are declared: [codedx] in the codedx headers
# under include/, otherwise the header(s) holding the generated declarations. Names
# tagged [framework/mods] on an entry are the ones a framework part or mod needs.
# Constructors and destructors carry their C1/C2/D0/D1/D2 variant.

# AreaTask  [modbase/game/runtime/startup.h]
AreaTask::create() = 0x00022DCC;
AreaTask::AreaTask(int) as C1 = 0x003F1530;
AreaTask::AreaTask(int) as C2 = 0x003F1530;
AreaTask::getWrappedXPos(float) = 0x003F4900;

# CalculateTask2  [modbase/game/runtime/startup.h]
CalculateTask2::CalculateTask2(int, int) as C1 = 0x00818330;
CalculateTask2::CalculateTask2(int, int) as C2 = 0x00818330;

# CalculateTask3  [modbase/game/runtime/startup.h]
CalculateTask3::CalculateTask3(int, int) as C1 = 0x007F5AD8;
CalculateTask3::CalculateTask3(int, int) as C2 = 0x007F5AD8;

