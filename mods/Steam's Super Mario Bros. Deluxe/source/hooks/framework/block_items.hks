    address:    0x005B5A3C
    symbol:     ModBase::blockItems::spawnSingle(StageActor*, void*, int, int, int)
    trampoline: ModBase::blockItems::spawnSingle_orig(StageActor*, void*, int, int, int)

@ Block spawnPowerup, one item per player
BlockItems_spawnMulti:
    type:       hook
    address:    0x005B5FA8
    symbol:     ModBase::blockItems::spawnMulti(StageActor*, void*, int, int, int)
    trampoline: ModBase::blockItems::spawnMulti_orig(StageActor*, void*, int, int, int)

@ ItemMgr::spawnItem: the funnel every block, brick and crate item goes through
BlockItems_spawnItem:
