@ Replace original Profile functions to consider custom profiles
Profile_ctor:
    type:     hook
    address:  0x00017F6C
    symbol:   Profile::Profile(Actor* (*)(ActorBuildInfo const*), unsigned int, sead::SafeStringBase<char> const&, ActorInfo const*, unsigned int)

Profile_get:
    type:     hook
    address:  0x000182A0
    symbol:   Profile::get(unsigned int)

Profile_getPriority:
    type:     hook
    address:  0x0001839C
    symbol:   Profile::getPriority(unsigned int)

Profile_getHasResources:
    type:     hook
    address:  0x000183C8
    symbol:   Profile::getHasResources(unsigned int)

Profile_getResourceCount:
    type:     hook
    address:  0x000183F0
    symbol:   Profile::getResourceCount(unsigned int)

Profile_getResourceList:
    type:     hook
    address:  0x00020FF0
    symbol:   Profile::getResourceList(unsigned int)


@ Disable max sprite count checks (Warning: Invalid sprite ids will now crash!)
SpriteToProfileTableSize1:
    type:         instr
    instruction:  cmp r1, #0x10000
    address:      0x000046A0

SpriteToProfileTableSize2:
    type:         instr
    instruction:  cmp r1, #0x10000
    address:      0x00006250

SpriteToProfileTableSize3:
    type:         instr
    instruction:  cmp r1, #0x10000
    address:      0x0000642C

SpriteToProfileTableSize4:
    type:         instr
    instruction:  cmp r1, #0x10000
    address:      0x000065A4

SpriteToProfileTableSize5:
    type:         instr
    instruction:  cmp r1, #0x10000
    address:      0x000066FC

SpriteToProfileTableSize6:
    type:         instr
    instruction:  cmp r1, #0x10000
    address:      0x00006C34


@ Disables the game from setting original sprite -> profile ids
SpriteToProfileTableNoSInit:
    type:         instr
    instruction:  bx lr
    address:      0x00014724


ProfileCountLoadArchives:
    type:    call
    symbol:  loadNumProfilesR4
    address: 0x0000919C

ProfileCountUnloadAll:
    type:    call
    symbol:  loadNumProfilesR6
    address: 0x00009264