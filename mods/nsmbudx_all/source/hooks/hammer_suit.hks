@ Hammer Flower power-up. Deluxe (Switch) v1.0.0 only.
@ Every entry below is a `push`, position-independent, so each trampoline can
@ replay it (sdk/data/hookable.csv; 0x0045DDC0 checked in the disassembly).

@ Player::createFireBall (0x007AABA0) is hooked once, by framework/player
@ (nsmbudx/throws.h); the mod registers a throw handler there.

@ Fire Flower per-frame collect check (vtable +0xE0): sub_60463998(item, &out, 2, 1)
HammerFlower_grant:
    type:       hook
    address:    0x0045DDC0
    symbol:     HammerFlower_grant
    trampoline: HammerFlower_grant_orig

@ Fire Flower item functions that name "I_fireflower"
HammerFlower_createModel:
    type:       hook
    address:    0x0045D79C
    symbol:     HammerFlower_createModel
    trampoline: HammerFlower_createModel_orig

HammerFlower_animOut:
    type:       hook
    address:    0x0045D980
    symbol:     HammerFlower_animOut
    trampoline: HammerFlower_animOut_orig

HammerFlower_animOut3:
    type:       hook
    address:    0x0045DA4C
    symbol:     HammerFlower_animOut3
    trampoline: HammerFlower_animOut3_orig

HammerFlower_animWait:
    type:       hook
    address:    0x0045DB18
    symbol:     HammerFlower_animWait
    trampoline: HammerFlower_animWait_orig

HammerFlower_animWait2:
    type:       hook
    address:    0x0045DBF8
    symbol:     HammerFlower_animWait2
    trampoline: HammerFlower_animWait2_orig

HammerFlower_animOut2:
    type:       hook
    address:    0x0045DCC4
    symbol:     HammerFlower_animOut2
    trampoline: HammerFlower_animOut2_orig

@ The helmet and shell use framework/player's model listeners
@ (nsmbudx/player_models.h), which own the PlayerModel constructor and draw hooks.
