@ Scoped archive/model name remapping (framework/resources).
@ Both entries are `push` instructions, position-independent, so the
@ trampolines can replay them (sdk/data/hookable.csv).

NameRemap_archiveGet:
    type:       hook
    address:    0x0043B548
    symbol:     NameRemap_archiveGet
    trampoline: NameRemap_archiveGet_orig

NameRemap_getModel:
    type:       hook
    address:    0x00430090
    symbol:     NameRemap_getModel
    trampoline: NameRemap_getModel_orig
