<?xml version="1.0"?>
<!--
    A dedicated view for the Cheep Cheep family.

    Yaz0moto groups patch-added views alongside the base game's. Category names
    here are unique to this view so nothing is merged into a base category.

    Splitting note: the family is presented by behaviour, because that is what
    distinguishes the variants. Several sprites share one resource
    (`pukupuku.szs`) and differ only in the settings documented in spritedata.xml.

    The four sprites the base game marks UNUSED are grouped last and left
    labelled as such : this view collects them, it does not promise they work.
-->
<views>
    <view name="Cheep Cheep Family">

        <category name="Swimming">
            <attach sprite="101" />   <!-- Cheep Cheep                    530 -->
            <attach sprite="113" />   <!-- Medium-sized Cheep Cheep       532 -->
            <attach sprite="482" />   <!-- Mecha Cheep                    538 -->
            <attach sprite="114" />   <!-- Cheep Cheep Formation [UNUSED] 547 -->
        </category>

        <category name="Following / Search">
            <attach sprite="588" />   <!-- Deep Cheep                     534 -->
            <attach sprite="589" />   <!-- Medium Deep Cheep              535 -->
            <attach sprite="590" />   <!-- Eep Cheep                      536 -->
            <attach sprite="591" />   <!-- Medium Eep Cheep               537 -->
            <attach sprite="592" />   <!-- Searching Cheep Cheep [UNUSED] 543 -->
        </category>

        <category name="Spiny / Jumping">
            <attach sprite="120" />   <!-- Spiny Cheep Cheep              539 -->
            <attach sprite="129" />   <!-- Jumping Cheep Cheep            540 -->
            <attach sprite="587" />   <!-- Flying Mecha Cheep [UNUSED]    541 -->
        </category>

        <category name="Grouped">
            <attach sprite="615" />   <!-- Grouped Cheep Cheep            531 -->
            <attach sprite="723" />   <!-- Medium-sized Grouped           533 -->
            <attach sprite="616" />   <!-- Group Controller (companion)       -->
        </category>

        <category name="Spawn Areas">
            <attach sprite="106" />   <!-- Cheep Cheep Spawn Location     542 -->
            <attach sprite="131" />   <!-- Jumping Cheep Cheep Spawn Area 545 -->
            <attach sprite="597" />   <!-- Eep Cheep Spawner [UNUSED]     544 -->
            <attach sprite="586" />   <!-- Flying Mecha Cheep Spawner     546 -->
        </category>

    </view>
</views>
