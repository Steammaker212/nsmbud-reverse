# State machines
#
# Addresses are RVAs (VA - 0x60000000). New Super Mario Bros. U Deluxe (Switch) v1.0.0 only.
# Each group's tag says where its names are declared: [codedx] in the codedx headers
# under include/, otherwise the header(s) holding the generated declarations. Names
# tagged [framework/mods] on an entry are the ones a framework part or mod needs.
# Constructors and destructors carry their C1/C2/D0/D1/D2 variant.

# NullState  [modbase/game/actors/states.h]
NullState::getId() = 0x00013DB4;

# State  [actors/states.h]
State<MovementHandler>::~State() as D0 = 0x006B235C;

# StateBase  [codedx]
StateBase::currentId = 0x00C7B788;

# StateMgr  [codedx]
StateMgr::getCurrentState() = 0x00818198;
StateMgr::execute() = 0x008181D4;
StateMgr::changeState(StateBase*) = 0x00818224;

# StateMgr  [actors/states.h]
StateMgr::StateMgr(void*, void*) as C1 = 0x00818168;
StateMgr::StateMgr(void*, void*) as C2 = 0x00818168;

# StateMgrExt  [modbase/game/actors/states.h]
StateMgrExt::changeState(void*) = 0x00818290;

# StateVirtual  [actors/states.h]
StateVirtual<BroBase>::vf2(int) = 0x002675A8;
StateVirtual<Enemy>::~StateVirtual() as D0 = 0x002A82E8;
StateVirtual<Enemy>::getId() = 0x002A82EC;
