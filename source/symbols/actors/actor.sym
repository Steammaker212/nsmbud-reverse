Actor::beforeCreate() = 0x00002EF8;
Actor::onCreate() = 0x00002F00;
Actor::afterCreate(unsigned int) = 0x00002F08;
Actor::beforeExecute() = 0x00002F0C;
Actor::onExecute() = 0x00002F3C;
Actor::afterExecute(unsigned int) = 0x00002F44;
Actor::finalExecute() = 0x00002F48;
Actor::beforeDraw() = 0x00002F4C;
Actor::onDraw() = 0x00002F54;
Actor::afterDraw(unsigned int) = 0x00002F5C;
Actor::beforeDelete() = 0x00002F60;
Actor::onDelete() = 0x00002F68;
Actor::afterDelete(unsigned int) = 0x00002F70;

