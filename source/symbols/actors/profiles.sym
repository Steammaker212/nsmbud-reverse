# Profiles and the archives they load
#
# Addresses are RVAs (VA - 0x60000000). New Super Mario Bros. U Deluxe (Switch) v1.0.0 only.
# Each group's tag says where its names are declared: [codedx] in the codedx headers
# under include/, otherwise the header(s) holding the generated declarations. Names
# tagged [framework/mods] on an entry are the ones a framework part or mod needs.
# Constructors and destructors carry their C1/C2/D0/D1/D2 variant.

# ActorInfo  [codedx]
ActorInfo::Default = 0x00AF2D04;

# ArchiveManagerMaybe  [modbase/game/actors/profiles.h]
ArchiveManagerMaybe::loadPack(void*, int) = 0x00821B28;

# LoadProfileArchives  [modbase/game/actors/profiles.h, modbase/game/runtime/startup.h]
game::LoadProfileArchives(int, void*) = 0x00008F10;
LoadProfileArchives::helper() = 0x003EE6EC;

# Profile  [codedx]
Profile::getResArchiveById(unsigned int) = 0x0001824C;
Profile::profilesOriginal = 0x00C7C304;
Profile::prioritiesOriginal = 0x00AF3B64;
Profile::hasResourcesOriginal = 0x00AF4288;
Profile::resourceCountOriginal = 0x00AF461A;
Profile::resourceListsOriginal = 0x00BC05F0;

# Profile  [actors/profile.h]
Profile::loadResources(int) = 0x00017FCC;
Profile::unsetResourcesLoaded() = 0x00018238;
Profile::vf0() = 0x000182C0;
Profile::getResourceCountById(unsigned int) = 0x000183F0;
Profile::getResourceListById(unsigned int) = 0x00020FF0;

# UnsetResourcesLoadedForAllProfiles  [modbase/game/runtime/startup.h]
game::UnsetResourcesLoadedForAllProfiles(int) = 0x00009250;
