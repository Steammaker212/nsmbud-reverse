TileGod::checkRTTI(void*) = 0x005CF804;
TileGod::getRTTI() = 0x005CF894;
TileGod::~TileGod() as D0 = 0x005CF908;

# TileLayer  [codedx]
TileLayer::getTilePtr(unsigned int, unsigned int, unsigned int*) = 0x007232D4;

# TileMgr  [level/tile.h]
TileMgr::createInstance() = 0x00710CB8;
