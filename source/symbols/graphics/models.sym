# ShaderAnimation  [codedx]
ShaderAnimation::play(ResArchive*, sead::SafeStringBase<char> const&) = 0x00445F80;

# ShaderAnimation  [graphics/model.h]  [framework/mods]
# Wii U ShaderParamAnimation::playTexSrtAnim. Same body as play (0x445F80), but it
# looks the name up in the archive's anim table 2 instead of table 1. play is the
# Wii U playColorAnim: Mario's "MLH_PtoNml" colour anims go through it (0x6075B25C).
ShaderAnimation::playTexSrt(ResArchive*, sead::SafeStringBase<char> const&) = 0x00446088;

