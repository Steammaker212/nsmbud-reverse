# Archives, models and animations
#
# Addresses are RVAs (VA - 0x60000000). New Super Mario Bros. U Deluxe (Switch) v1.0.0 only.
# Each group's tag says where its names are declared: [codedx] in the codedx headers
# under include/, otherwise the header(s) holding the generated declarations. Names
# tagged [framework/mods] on an entry are the ones a framework part or mod needs.
# Constructors and destructors carry their C1/C2/D0/D1/D2 variant.

# Animation  [graphics/model.h]
Animation::update() = 0x0040E904;

# AnimationBase  [modbase/game/graphics/models.h]
AnimationBase::AnimationBase() as C1 = 0x0040E8D8;
AnimationBase::AnimationBase() as C2 = 0x0040E8D8;

# AnimationCtrl  [modbase/game/graphics/models.h]
AnimationCtrl::AnimationCtrl() as C1 = 0x00418368;
AnimationCtrl::AnimationCtrl() as C2 = 0x00418368;

# ModelAnimation  [codedx]
Animation::setRepeat(bool) = 0x004183BC;

