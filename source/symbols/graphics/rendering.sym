# Drawing, lights and effects
#
# Addresses are RVAs (VA - 0x60000000). New Super Mario Bros. U Deluxe (Switch) v1.0.0 only.
# Each group's tag says where its names are declared: [codedx] in the codedx headers
# under include/, otherwise the header(s) holding the generated declarations. Names
# tagged [framework/mods] on an entry are the ones a framework part or mod needs.
# Constructors and destructors carry their C1/C2/D0/D1/D2 variant.

# DrawMgr  [codedx]
DrawMgr::instance = 0x00C9CD1C;
DrawMgr::drawModel(Model*) = 0x004432A4;
DrawMgr::drawTile(unsigned short, Vec3 const&, unsigned int const&, Vec3 const&) = 0x0044344C;

# DrawMgr  [graphics/drawmgr.h]
DrawMgr::drawModel2(void*) = 0x00443344;

# Effect  [codedx]
Effect::spawn(int, Vec3*, Vec3i*, Vec3*) = 0x00236DA0;

# EffectData  [modbase/game/graphics/rendering.h]
EffectData::EffectData() as C1 = 0x00235DD0;
EffectData::EffectData() as C2 = 0x00235DD0;
EffectData::setEffectId(int) = 0x00235EA0;
EffectData::init() = 0x0023601C;
EffectData::update(void*, void*, void*) = 0x00236430;
EffectData::setEffectId_helper(unsigned int) = 0x00239BDC;
EffectData::setEffectId_helper_239BF4(void*, int, unsigned int) = 0x00239BF4;
EffectData::init_helper() = 0x00881BA4;

