@ code/framework/suits.cpp: suit colours. The four model classes' colour routines
@ (virtual slot 44, vtable +0xB0) are not defined functions in the database;
@ each entry is a `push`, position-independent, so the trampolines can replay
@ it. Ledger F0050, F0061-F0063.

@ MarioModel (Mario, Luigi), vtable 0x60C23FAC.
Suits_setColorType:
    type:       hook
    address:    0x0075A6E4
    symbol:     ModBase::suits::setColorType(void*, unsigned int, bool)
    trampoline: ModBase::suits::setColorType_orig(void*, unsigned int, bool)

@ KinopioModel (Toads), vtable 0x60C23E94. Entry: push {r4-r8, lr}.
Suits_kinopioSetColorType:
    type:       hook
    address:    0x00757B58
    symbol:     ModBase::suits::kinopioSetColorType(void*, unsigned int, bool)
    trampoline: ModBase::suits::kinopioSetColorType_orig(void*, unsigned int, bool)

@ KinopicoModel (Toadette), vtable 0x60C23D34. Entry: push {r4-r7, r11, lr}.
Suits_kinopicoSetColorType:
    type:       hook
    address:    0x0075227C
    symbol:     ModBase::suits::kinopicoSetColorType(void*, unsigned int, bool)
    trampoline: ModBase::suits::kinopicoSetColorType_orig(void*, unsigned int, bool)

@ The Mii's model class, vtable 0x60C240DC. Entry: push {r4-r7, r11, lr}.
Suits_model3SetColorType:
    type:       hook
    address:    0x0075D3AC
    symbol:     ModBase::suits::model3SetColorType(void*, unsigned int, bool)
    trampoline: ModBase::suits::model3SetColorType_orig(void*, unsigned int, bool)

@ PlayerModel::setPlayerMode (0x6078E608, every model class): drops a suit whose
@ mode the game replaced outside a level (suits::requireMode). Entry
@ `push {r4-r7, r11, lr}`, so the trampoline can replay it.
Suits_setPlayerMode:
    type:       hook
    address:    0x0078E608
    symbol:     ModBase::suits::setPlayerMode(void*, unsigned int)
    trampoline: ModBase::suits::setPlayerMode_orig(void*, unsigned int)
